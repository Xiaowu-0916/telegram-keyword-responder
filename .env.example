# Application directory (use /app inside Docker)
TGKR_BASE_DIR=/srv/tg-keyword-responder

# Data directory
TGKR_DATA_DIR=/srv/tg-keyword-responder/data
TGKR_DB_PATH=/srv/tg-keyword-responder/data/state.db
TGKR_SESSION_PATH=/srv/tg-keyword-responder/data/account

# Web panel login
TGKR_ADMIN_USER=admin
TGKR_INITIAL_PASSWORD=change-me

# Fixed secret for signing session cookies (generate with: openssl rand -hex 32)
TGKR_SESSION_SECRET=change-me-to-a-long-random-string

# Set to 1 when the panel is served over HTTPS
TGKR_HTTPS_ONLY=0

# Listen address and port
TGKR_HOST=127.0.0.1
TGKR_PORT=8100
